@* 
  ASP.NET Core Master Layout (_Layout.cshtml)
  Super Admin Control Center
*@
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"] - Super Admin Control Center</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="~/styles.css" asp-append-version="true" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    :root { --admin-sidebar-width: 260px; --admin-sidebar-collapsed-width: 76px; --admin-header-height: 64px; }
    body.admin-body { background-color: var(--bg-primary); font-family: 'Inter', sans-serif; margin: 0; padding: 0; overflow-x: hidden; }
    .admin-header { position: fixed; top: 0; left: 0; right: 0; height: var(--admin-header-height); background: var(--bg-card); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border-color); z-index: 1000; display: flex; align-items: center; justify-content: space-between; padding: 0 1.5rem; }
    .admin-logo-group { display: flex; align-items: center; gap: 1rem; }
    .sidebar-toggle-btn { width: 36px; height: 36px; border-radius: 8px; background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .global-search-container { position: relative; width: 420px; }
    .global-search-container input { width: 100%; padding: 0.55rem 2.5rem; border-radius: 20px; background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.875rem; outline: none; }
    .search-icon-left { position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); }
    .search-shortcut-hint { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: var(--bg-card); border: 1px solid var(--border-color); font-size: 0.7rem; font-weight: 700; color: var(--text-muted); padding: 0.15rem 0.4rem; border-radius: 4px; }
    .header-actions-group { display: flex; align-items: center; gap: 0.75rem; }
    .icon-action-btn { width: 38px; height: 38px; border-radius: 50%; background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; cursor: pointer; position: relative; }
    .icon-badge { position: absolute; top: -2px; right: -2px; width: 18px; height: 18px; border-radius: 50%; background: var(--danger); color: #fff; font-size: 0.68rem; font-weight: 800; display: flex; align-items: center; justify-content: center; }
    .admin-sidebar { position: fixed; top: var(--admin-header-height); left: 0; bottom: 0; width: var(--admin-sidebar-width); background: var(--bg-secondary); border-right: 1px solid var(--border-color); z-index: 900; overflow-y: auto; padding: 1rem 0; transition: width var(--transition-normal); }
    body.sidebar-collapsed .admin-sidebar { width: var(--admin-sidebar-collapsed-width); }
    body.sidebar-collapsed .admin-sidebar .sidebar-label, body.sidebar-collapsed .admin-sidebar .menu-section-header, body.sidebar-collapsed .admin-sidebar .sidebar-badge { display: none; }
    body.sidebar-collapsed .admin-main-wrapper { margin-left: var(--admin-sidebar-collapsed-width); }
    .menu-section-header { font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); padding: 0.75rem 1.5rem 0.35rem; }
    .sidebar-menu-item { display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 1.25rem; margin: 0.15rem 0.75rem; border-radius: 10px; color: var(--text-secondary); font-size: 0.875rem; font-weight: 600; text-decoration: none; transition: all var(--transition-fast); }
    .sidebar-menu-item:hover { background: var(--bg-tertiary); color: var(--text-primary); }
    .sidebar-menu-item.active { background: var(--accent-gradient); color: #ffffff; box-shadow: var(--shadow-glow); }
    .admin-main-wrapper { margin-top: var(--admin-header-height); margin-left: var(--admin-sidebar-width); padding: 1.5rem 2rem 4rem; transition: margin-left var(--transition-normal); }
  </style>
</head>
<body class="admin-body">
  <div id="toast-container" class="toast-container"></div>

  <!-- Header -->
  <header class="admin-header">
    <div class="admin-logo-group">
      <button id="sidebar-toggle-btn" class="sidebar-toggle-btn">☰</button>
      <a href="/" class="brand-logo"><div class="brand-icon">🛡️</div><span>SVPMS<span class="text-gradient">.io</span></span></a>
      <span class="badge badge-primary">Super Admin Portal</span>
    </div>
    <div class="global-search-container">
      <span class="search-icon-left">🔍</span>
      <input type="text" id="global-search-input" placeholder="Search visitors, employees, gates, security logs, or settings...">
      <span class="search-shortcut-hint">Ctrl + K</span>
    </div>
    <div class="header-actions-group">
      <button class="icon-action-btn" id="theme-toggle-btn"><span id="theme-icon">🌙</span></button>
      <div style="display: flex; align-items: center; gap: 0.6rem; padding-left: 0.5rem; border-left: 1px solid var(--border-color);">
        <div class="user-avatar" style="width: 38px; height: 38px; background: var(--accent-gradient); font-weight: 800;">MV</div>
        <div><div style="font-weight: 800; font-size: 0.85rem;">Marcus Vance</div><div style="font-size: 0.72rem; color: var(--text-secondary);">Chief Security Officer</div></div>
      </div>
    </div>
  </header>

  <!-- Clean Unified Admin Sidebar Navigation -->
  <aside class="admin-sidebar" id="admin-sidebar">
    <div class="menu-section-header">Core Command</div>
    <a href="dashboard.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">📊</span>
        <span class="sidebar-label">Dashboard</span>
      </div>
    </a>
    <a href="analytics.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Analytics" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">📈</span>
        <span class="sidebar-label">Analytics</span>
      </div>
    </a>

    <div class="menu-section-header">Visitor Operations</div>
    <a href="visitors.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Visitors" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">👥</span>
        <span class="sidebar-label">Visitors</span>
      </div>
      <span class="badge badge-primary sidebar-badge" style="font-size: 0.7rem;">265</span>
    </a>
    <a href="approvals.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Approvals" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">🎫</span>
        <span class="sidebar-label">Approvals</span>
      </div>
      <span class="badge badge-warning sidebar-badge" style="font-size: 0.7rem;">17</span>
    </a>

    <div class="menu-section-header">Workplace</div>
    <a href="employees.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Employees" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">💼</span>
        <span class="sidebar-label">Employees</span>
      </div>
    </a>
    <a href="departments.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Departments" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">🏢</span>
        <span class="sidebar-label">Departments & Gates</span>
      </div>
    </a>
    <a href="passes.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Passes" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">🔳</span>
        <span class="sidebar-label">Pass Studio</span>
      </div>
    </a>

    <div class="menu-section-header">Security</div>
    <a href="blacklist.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Blacklist" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">🛡️</span>
        <span class="sidebar-label">Watchlist</span>
      </div>
      <span class="badge badge-danger sidebar-badge" style="font-size: 0.7rem;">9</span>
    </a>
    <a href="activity-logs.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Logs" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">📜</span>
        <span class="sidebar-label">Audit Logs</span>
      </div>
    </a>
    <a href="reports.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Reports" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">📊</span>
        <span class="sidebar-label">Reports</span>
      </div>
    </a>

    <div class="menu-section-header">System</div>
    <a href="masters.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Masters" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">📑</span>
        <span class="sidebar-label">Masters</span>
      </div>
    </a>
    <a href="users-roles.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Users" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">🔐</span>
        <span class="sidebar-label">Users & Roles</span>
      </div>
    </a>
    <a href="settings.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Settings" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">⚙️</span>
        <span class="sidebar-label">Settings</span>
      </div>
    </a>
    <a href="profile.html" class="sidebar-menu-item @(ViewData["ActivePage"]?.ToString() == "Profile" ? "active" : "")">
      <div style="display: flex; align-items: center; gap: 0.75rem;">
        <span class="sidebar-icon">👤</span>
        <span class="sidebar-label">Profile</span>
      </div>
    </a>

    <div style="margin-top: 1.5rem; padding: 0.75rem 1rem; border-top: 1px solid var(--border-color);">
      <a href="../index.html" class="btn btn-outline btn-full" style="text-decoration: none; justify-content: center; font-size: 0.85rem;">
        Log Out ➔
      </a>
    </div>
  </aside>

  <!-- Body Content rendered by Razor -->
  <main class="admin-main-wrapper">
    @RenderBody()
  </main>

  <script src="~/app.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
